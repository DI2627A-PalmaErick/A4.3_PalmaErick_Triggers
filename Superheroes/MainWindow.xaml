<Window x:Class="Superheroes.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Superheroes"
        mc:Ignorable="d"
        Title="Superheroes Triggers" 
        Height="550" Width="650"
        MinHeight="400" MinWidth="450"
        Icon="Assets/shield.ico">

    <Window.Resources>
        <Style x:Key="FondoHeroeVillanoStyle" TargetType="DockPanel">
            <Setter Property="Background" Value="#55E6B5"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding Heroe}" Value="False">
                    <Setter Property="Background" Value="#DD5B55"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="LogotipoAfiliacionStyle" TargetType="Image">
            <Setter Property="Visibility" Value="Visible"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding Heroe}" Value="False">
                    <Setter Property="Visibility" Value="Collapsed"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="NombreAnimadoStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontFamily" Value="Arial Black"/>
            <Setter Property="FontSize" Value="40"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect Color="Black" BlurRadius="2" ShadowDepth="3" Direction="315" Opacity="1"/>
                </Setter.Value>
            </Setter>
            <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
            <Setter Property="RenderTransform">
                <Setter.Value>
                    <RotateTransform CenterX="0" CenterY="0"/>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <EventTrigger RoutedEvent="MouseLeftButtonDown">
                    <BeginStoryboard Name="RotateOnHover">
                        <Storyboard RepeatBehavior="Forever">
                            <DoubleAnimation
                                Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)"
                                From="0" To="360"
                                Duration="0:0:2"
                                AutoReverse="False" />
                        </Storyboard>
                    </BeginStoryboard>
                </EventTrigger>
                <EventTrigger RoutedEvent="MouseRightButtonDown">
                    <StopStoryboard BeginStoryboardName="RotateOnHover"/>
                </EventTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="BorderImagenStyle" TargetType="Border">
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="4"/>
            <Setter Property="Opacity" Value="0.5"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Opacity" Value="1.0"/>
                    <Setter Property="BorderBrush" Value="DarkViolet"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <DockPanel Style="{StaticResource FondoHeroeVillanoStyle}">
        <DockPanel DockPanel.Dock="Top" Margin="25,15,25,10">
            <TextBlock Text="{Binding Nombre}" 
                       VerticalAlignment="Center"
                       Background="Transparent"
                       Style="{StaticResource NombreAnimadoStyle}" />

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                <Image Source="Assets/avengers.png" Height="45" Margin="5,0">
                    <Image.Style>
                        <Style TargetType="Image" BasedOn="{StaticResource LogotipoAfiliacionStyle}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Vengador}" Value="False">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Image.Style>
                </Image>

                <Image Source="Assets/xmen.png" Height="45" Margin="5,0">
                    <Image.Style>
                        <Style TargetType="Image" BasedOn="{StaticResource LogotipoAfiliacionStyle}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Xmen}" Value="False">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Image.Style>
                </Image>
            </StackPanel>
        </DockPanel>

        <DockPanel DockPanel.Dock="Bottom" Margin="10,5,10,15">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <Image Source="Assets/arrow.png" Width="26" Margin="8,0" Cursor="Hand" MouseLeftButtonDown="Anterior_MouseLeftButtonDown"/>

                <TextBlock Text="{Binding PosicionActual, RelativeSource={RelativeSource AncestorType=Window}}" 
                           FontSize="18" VerticalAlignment="Center" FontWeight="Bold"/>
                <TextBlock Text="/" FontSize="18" VerticalAlignment="Center" Margin="3,0" FontWeight="Bold"/>
                <TextBlock Text="{Binding TotalSuperheroes, RelativeSource={RelativeSource AncestorType=Window}}" 
                           FontSize="18" VerticalAlignment="Center" FontWeight="Bold"/>

                <Image Source="Assets/arrow.png" Width="26" Margin="8,0" RenderTransformOrigin="0.5,0.5" Cursor="Hand" MouseLeftButtonDown="Siguiente_MouseLeftButtonDown">
                    <Image.RenderTransform>
                        <ScaleTransform ScaleX="-1"/>
                    </Image.RenderTransform>
                </Image>
            </StackPanel>
        </DockPanel>

        <Border Style="{StaticResource BorderImagenStyle}" Margin="20,5,20,5" CornerRadius="4">
            <Image Source="{Binding ImagenRuta}" Stretch="Fill"/>
        </Border>
    </DockPanel>
</Window>